{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwissDocAI Redact",
  "version": "0.1.0",
  "identifier": "ch.swissdocai.redact",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SwissDocAI Redact",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SwissDocAI",
    "license": "Apache-2.0",
    "homepage": "https://swissdocai.ch",
    "category": "Productivity",
    "shortDescription": "Personendaten in Dokumenten automatisch schwärzen",
    "longDescription": "SwissDocAI Redact findet Personendaten in Schweizer Dokumenten und schwärzt sie – auf diesem Computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "French", "Italian", "English"],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
